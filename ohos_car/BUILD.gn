import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

config("warns") {
  cflags = [ "-Werror" ]
}

ohos_executable("ohos_car") {
  install_enable = true

  sources = [
    "pthread_usr.c",
    "serial_base.c",
    "serial_protocol.c",
    "serial.c",
    "wit_c_sdk.c",
    "main.c",
    "controller.c",
    "square_walk.c",
    "circle_walk.c"
  ]

  include_dirs = [ "." ]
  install_images = [ "system" ]
  part_name = "ohos_car"
}
